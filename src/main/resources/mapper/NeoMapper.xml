<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.in.mzncvmc.content.neo.mapper.NeoMapper">

    <select id="findAll" resultType="com.in.mzncvmc.content.neo.Neo">
        SELECT id,
               company,
               addr,
               tel
          FROM neo
    </select>

    <select id="findById" parameterType="long" resultType="com.in.mzncvmc.content.neo.Neo">
        SELECT id, company, addr, tel
          FROM neo
         WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.in.mzncvmc.content.neo.Neo">
        INSERT
          INTO neo(
                   company,
                   addr,
                   tel
               )
        VALUES (
                #{company},
                #{addr},
                #{tel}
               )
    </insert>

    <update id="update" parameterType="com.in.mzncvmc.content.neo.Neo">
        UPDATE neo
           SET company=#{company},
               addr=#{addr},
               tel=#{tel}
         WHERE id=#{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE
          FROM neo
         WHERE id = #{id}
    </delete>

</mapper>
